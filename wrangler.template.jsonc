{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estatemate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estatemate-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ACCESS_EVENTS", "queue": "estatemate-access-events" }
    ],
    "consumers": [
      {
        "queue": "estatemate-access-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "estatemate-access-events-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_FEED", "class_name": "AccessLiveFeed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccessLiveFeed"] }
  ],
  "triggers": {
    // Hourly estate housekeeping, plus a per-minute sweep that deletes visitor
    // device accounts as soon as their validity ends. Cloudflare's cron
    // granularity is one minute, so this is the fastest automatic release
    // available; both schedules fit the free plan's three-trigger limit.
    "crons": ["15 * * * *", "* * * * *"]
  },
  "vars": {
    "APP_NAME": "EstateMate",
    "ALLOWED_ORIGINS": "",
    "HIKVISION_MODE": "per-device",
    "FILE_STORAGE_MODE": "github-private-configurable"
  },
  // Cloudflare Workers Builds runs `wrangler preview` for non-production
  // branches. Preview settings are isolated and do not inherit production
  // bindings. Keep this safe by omitting D1 and Queue bindings until dedicated
  // staging resources exist; never point a PR Preview at estate production data.
  "previews": {
    "vars": {
      "APP_NAME": "EstateMate Preview",
      "ALLOWED_ORIGINS": "",
      "HIKVISION_MODE": "per-device",
      "FILE_STORAGE_MODE": "disabled"
    },
    // Each Worker Preview receives an isolated namespace for this binding.
    "durable_objects": {
      "bindings": [
        { "name": "LIVE_FEED", "class_name": "AccessLiveFeed" }
      ]
    }
  }
}
