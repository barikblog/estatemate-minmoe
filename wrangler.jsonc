{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estatemate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "estatemate-db",
    "database_id": "local-placeholder-replace-before-deploy",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "estatemate-private" }],
  "queues": {
    "producers": [{ "binding": "ACCESS_EVENTS", "queue": "estatemate-access-events" }],
    "consumers": [{
      "queue": "estatemate-access-events",
      "max_batch_size": 50,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "dead_letter_queue": "estatemate-access-events-dlq"
    }]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_FEED", "class_name": "AccessLiveFeed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccessLiveFeed"] }],
  "triggers": { "crons": ["15 * * * *"] },
  "vars": {
    "APP_NAME": "EstateMate",
    "ALLOWED_ORIGINS": "",
    "HIKVISION_MODE": "http-listener-events-only"
  }
}
