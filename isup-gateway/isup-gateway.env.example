# Install as /etc/estatemate/isup-gateway.env with mode 0600.
ESTATEMATE_WORKER_URL=https://estatemate.estatemate.workers.dev
ADAPTER_SHARED_SECRET=replace-with-at-least-32-random-characters

# These ports are consumed by the official Hikvision SDK adapter, not the Node control plane.
ISUP_REGISTRATION_PORT=7660
ISUP_ALARM_PORT=7332
ISUP_BIND_ADDRESS=0.0.0.0
# Recommended on a local appliance: the access-device VLAN/subnet, for example 192.168.20.0/24.
# On a cloud VM, use the estate's public egress CIDR where stable.
ISUP_ALLOWED_CIDR=
ISUP_CONTROL_URL=http://127.0.0.1:8788
