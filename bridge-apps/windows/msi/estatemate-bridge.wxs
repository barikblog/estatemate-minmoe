<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX source for the EstateMate Bridge MSI installer.

  Built by scripts/package-bridge-msi.mjs with the WiX Toolset v3 that the
  GitHub Actions windows-latest runner ships preinstalled:

      candle -arch x64 -dVersion=<x.y.z> -dExeSource=<staged exe> \
             -dReadmeSource=<staged readme> estatemate-bridge.wxs -out <obj>
      light  -sice:ICE43 <obj> -out estatemate-bridge-<x.y.z>-win-x64.msi

  What the installer deliberately IS:

    * the single-file bridge executable in "C:\Program Files\EstateMate Bridge",
      plus a short README.txt with the five-minute setup;
    * Start Menu shortcuts that open console windows that STAY OPEN — the bare
      exe is a console tool, and double-clicking it directly flashes a window
      and exits, which is exactly the "it is not installing" confusion this
      installer exists to remove;
    * an App Paths registry value, so Win+R "estatemate-bridge" works;
    * the install directory appended to the system PATH, so any PowerShell or
      cmd can run `estatemate-bridge` by name;
    * a proper Programs-and-Features entry, upgrades in place (stable
      UpgradeCode, same-version reinstalls allowed) and a clean uninstall.

  What it deliberately is NOT:

    * it does not register the start-at-boot scheduled task — that needs the
      agent credentials from the portal first (`estatemate-bridge setup`, then
      `check`, then `install-service` from an Administrator console);
    * it does not touch %ProgramData%\EstateMate — configuration, secrets and
      logs live there, so an uninstall or upgrade never destroys them.

  The non-advertised shortcuts live in the per-machine component keyed on the
  executable. ICE43 objects to non-advertised shortcuts without an HKCU
  keypath (a per-user repair nuance that does not apply to an all-users
  shortcut for a per-machine console tool), so light suppresses that one ICE;
  every other validation rule still runs.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Id="*" gives every build a fresh ProductCode; the UpgradeCode below is
       permanent, and MajorUpgrade makes 0.2.0 -> 0.3.0 an in-place upgrade. -->
  <Product Id="*" Name="EstateMate Bridge" Language="1033" Version="$(var.Version)"
           Manufacturer="EstateMate" UpgradeCode="BE4C3E0B-927B-471E-92DE-A0BFAEF4C266">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="EstateMate access-device agent (Windows installer)" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of EstateMate Bridge is already installed. Remove it in Settings - Apps (run 'estatemate-bridge uninstall-service' first) and try again." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Shows up as the "Visit support site" link in Programs and Features. -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/barikblog/estatemate-minmoe" />

    <Feature Id="Main" Title="EstateMate Bridge" Level="1" AllowAbsent="no">
      <ComponentRef Id="BridgeExecutable" />
      <ComponentRef Id="BridgeReadme" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="EstateMate Bridge">

          <!-- The executable, the shortcuts and the PATH/App Paths entries
               come and go together. -->
          <Component Id="BridgeExecutable" Guid="*">
            <File Id="BridgeExe" Name="estatemate-bridge.exe" Source="$(var.ExeSource)" KeyPath="yes" />

            <!-- Win+R "estatemate-bridge" opens the bridge, no PATH needed. -->
            <RegistryValue Root="HKLM"
                           Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\estatemate-bridge.exe"
                           Type="string" Value="[INSTALLDIR]estatemate-bridge.exe" />

            <!-- `estatemate-bridge` from any shell. Windows Installer appends
                 this on install and removes exactly this entry on uninstall. -->
            <Environment Id="BridgeOnPath" Name="PATH" Value="[INSTALLDIR]"
                         Permanent="no" Part="last" Action="set" System="yes" />

            <!-- Start Menu: each shortcut opens a console that stays open in
                 the install directory, so follow-up commands just work. -->
            <Shortcut Id="StartMenuConsole" Directory="ApplicationProgramsFolder"
                      Name="EstateMate Bridge Console" Description="Open a console for the EstateMate bridge commands"
                      Target="[System64Folder]cmd.exe" Arguments="/K estatemate-bridge.exe help"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="StartMenuCheck" Directory="ApplicationProgramsFolder"
                      Name="Check configuration" Description="Validate the config, the Worker and every terminal"
                      Target="[System64Folder]cmd.exe" Arguments="/K estatemate-bridge.exe check"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="StartMenuStatus" Directory="ApplicationProgramsFolder"
                      Name="Service status" Description="Paths, scheduled-task state and recent log lines"
                      Target="[System64Folder]cmd.exe" Arguments="/K estatemate-bridge.exe status"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="StartMenuReadme" Directory="ApplicationProgramsFolder"
                      Name="Read me first" Description="The five-minute setup guide"
                      Target="[INSTALLDIR]README.txt" WorkingDirectory="INSTALLDIR" />

            <!-- Take the Start Menu folder away again when the last file goes. -->
            <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
          </Component>

          <Component Id="BridgeReadme" Guid="*">
            <File Id="BridgeReadme" Name="README.txt" Source="$(var.ReadmeSource)" KeyPath="yes" />
          </Component>

        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="EstateMate Bridge" />
      </Directory>
    </Directory>

  </Product>
</Wix>
