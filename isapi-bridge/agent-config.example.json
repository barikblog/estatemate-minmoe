{
  "agentId": "00000000-0000-4000-a000-000000000000",
  "agentSecret": "replace-with-agent-secret-from-portal",
  "workerUrl": "https://estatemate.estatemate.workers.dev",
  "syncIntervalSeconds": 30,
  "heartbeatIntervalSeconds": 60,
  "eventStream": true,
  "eventFlushCount": 25,
  "eventFlushSeconds": 5,
  "eventBufferLimit": 500,
  "logLevel": "info",
  "isapiTimeoutMs": 15000,
  "maxRetries": 3,
  "zktecoPush": {
    "enabled": false,
    "port": 8089,
    "bindAddress": "127.0.0.1",
    "ackTimeoutSeconds": 180,
    "requireAgentKey": false,
    "agentKey": ""
  },
  "remoteVerify": {
    "enabled": false,
    "snapshotIntervalSeconds": 60,
    "pageSize": 2000,
    "cardNumberFormats": [
      "exact",
      "padded10"
    ]
  },
  "timeSync": {
    "enabled": false,
    "maxDriftMs": 30000,
    "checkIntervalMinutes": 15,
    "timeZone": ""
  },
  "lanEvents": {
    "enabled": false,
    "port": 8080,
    "bindAddress": "127.0.0.1",
    "requireTerminalKey": false,
    "terminalKey": ""
  }
}
